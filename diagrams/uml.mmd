classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet_name: str) None
        +get_pet(pet_name: str) Pet
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +edit_task(task_id: int, **changes) None
        +remove_task(task_id: int) None
        +get_tasks() list~Task~
    }

    class Task {
        +int task_id
        +str title
        +int duration_minutes
        +str priority
        +str preferred_time
        +str frequency
        +bool completed
        +mark_complete() None
        +mark_incomplete() None
        +is_due_today(date) bool
        +next_occurrence() date
    }

    class Scheduler {
        +Owner owner
        +list~Task~ plan
        +get_todays_tasks() list~Task~
        +sort_by_priority(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +detect_conflicts() list~str~
        +generate_plan() list~Task~
        +explain_plan() str
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : plans for
